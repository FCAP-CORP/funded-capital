# dependencies
node_modules/
/.pnp
.pnp.js
.yarn/install-state.gz

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
# `.env.local*` (not `.env*.local`) so SUFFIXED copies are caught too:
# .env.local.before-dev-branch is written by scripts/set-dev-db.mjs and holds
# the production database credentials this machine used before the dev-branch
# switch. The older pattern required the name to END in `.local`, so that file
# was not ignored and was one `git add -A` away from being published.
.env*.local
.env.local*
.env

# Vercel credential pull scratch file. NOT matched by the patterns above —
# fc-db.bat deletes it, but if a run fails partway it must never be committed.
.env.vercel

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# clerk configuration (can include secrets)
/.clerk/

# repo health check output (local diagnostic, read by Claude from disk)
/.fc-check/

# One-shot commit scripts. Each fc-commit-<thing>.bat exists to make ONE commit,
# is run once, and then has no further use — keeping them would grow the repo
# root by a file per feature forever. Durable tooling (fc-check, fc-db, fc-dev,
# fc-migrate-*, fc-fix-local-crm and friends) IS tracked and belongs in git:
# if this machine dies, those are what a new one needs on day one.
fc-commit-*.bat

# Scratch screenshots and working files from Claude sessions. Not repo material.
/Claude outputs/

.queue-token
.cron-secret

.cron-secret
